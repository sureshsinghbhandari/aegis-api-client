# Aegis API Client has no required environment variables.
# Optional overrides (all unset by default):

# Path to an enterprise policy file (JSON). See SECURITY.md "Enterprise policy".
# AEGIS_POLICY_FILE=C:\ProgramData\Aegis\policy.json

# Override the user-data directory (database, logs, backups).
# AEGIS_USER_DATA_DIR=./.aegis-data
