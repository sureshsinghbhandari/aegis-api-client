{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@aegis/core": ["./packages/core/src/index.ts"],
      "@aegis/security": ["./packages/security/src/index.ts"],
      "@aegis/storage": ["./packages/storage/src/index.ts"],
      "@aegis/variables": ["./packages/variables/src/index.ts"],
      "@aegis/authentication": ["./packages/authentication/src/index.ts"],
      "@aegis/http-client": ["./packages/http-client/src/index.ts"],
      "@aegis/scripting": ["./packages/scripting/src/index.ts"],
      "@aegis/postman": ["./packages/postman/src/index.ts"],
      "@aegis/testing": ["./packages/testing/src/index.ts"],
      "@aegis/app": ["./packages/app/src/index.ts"],
      "@aegis/codegen": ["./packages/codegen/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx", "tests/**/*.ts", "scripts/**/*.ts", "vitest.config.ts", "drizzle.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "release", "**/*.d.ts.map"]
}
