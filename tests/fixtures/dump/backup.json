        "name": "Orders API",
        "description": "v2.1 collection inside a data dump",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "item": [
        {
          "name": "Orders",
          "item": [
            {
              "name": "List orders",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
                "url": { "raw": "{{baseUrl}}/orders?status=open", "host": ["{{baseUrl}}"], "path": ["orders"], "query": [{ "key": "status", "value": "open" }] }
              },
              "response": []
            },
            {
              "name": "Create order",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
                "body": { "mode": "raw", "raw": "{\"sku\":\"A-1\",\"qty\":2}", "options": { "raw": { "language": "json" } } },
                "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
              },
              "response": []
            }
          ]
        }
      ],
      "variable": [{ "key": "baseUrl", "value": "https://orders.example.com/v1", "type": "string" }]
    },
    {
      "id": "0c9b8a7f-6e5d-4c3b-9a2f-1e0d9c8b7a6f",
      "name": "Legacy Billing",
      "description": "v1 collection inside the same dump",
      "order": ["req_invoices"],
      "folders_order": ["fld_payments"],
      "folders": [{ "id": "fld_payments", "name": "Payments", "order": ["req_pay"], "folders_order": [] }],
      "requests": [
        {
          "id": "req_invoices",
          "name": "List invoices",
          "url": "https://billing.example.com/invoices?limit=10",
          "method": "GET",
          "headers": "Accept: application/json",
          "dataMode": null,
          "currentHelper": "bearerAuth",
          "helperAttributes": { "id": "bearer", "token": "billing-literal" },
          "responses": []
        },
        {
          "id": "req_pay",
          "name": "Pay invoice",
          "url": "https://billing.example.com/invoices/:id/pay",
          "method": "POST",
          "headers": "Content-Type: application/json",
          "pathVariables": { "id": "INV-1" },
          "dataMode": "raw",
          "rawModeData": "{\"method\":\"card\"}",
          "tests": "pm.test('paid', () => pm.response.to.have.status(200));",
          "responses": [],
          "folder": "fld_payments"
        }
      ]
    },
    { "name": "Broken entry", "foo": 1 },
